{
  "manifest_version": 3,
  "name": "GitHub QoL Extensions",
  "version": "1.1",
  "permissions": ["scripting", "activeTab", "clipboardWrite"],
  "action": {
    "default_title": "QoL Extensions"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*/*"],
      "js": ["pr-link-copier.js", "workflows-filter.js"],
      "css": ["workflows-filter.css"],
      "run_at": "document_idle"
    }
  ],
    "icons": {
    "128": "icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icon.png", "iconPressed.png", "iconDoublePressed.png", "approvers.txt"],
      "matches": ["https://github.com/*"]
    }
  ]
}
